.build/
build/
*.app
.DS_Store

# iOS project is generated by XcodeGen (ios/project.yml)
ios/*.xcodeproj
# XcodeGen writes these from project.yml's `info:` on every generate.
ios/Skreener/Info.plist
ios/SkreenerShare/Info.plist
ios/SkreenerBroadcast/Info.plist
ios/SkreenerControls/Info.plist
# And the entitlements, from `entitlements:`.
ios/Skreener/Skreener.entitlements
ios/SkreenerShare/SkreenerShare.entitlements
ios/SkreenerBroadcast/SkreenerBroadcast.entitlements
# Local signing (DEVELOPMENT_TEAM); see ios/README.md.
ios/Local.xcconfig
# Build number stamped by ios/stamp_build_number.sh on each `xcodegen generate`.
ios/BuildNumber.xcconfig
